# `npm run bootstrap` creates `.env.local` with a random master key.
# Never commit `.env.local` or a real key.
KOTMAIL_MASTER_KEY=
KOTMAIL_DATA_DIR=./data
KOTMAIL_SETUP_HOST=127.0.0.1
KOTMAIL_SETUP_PORT=3210

# Optional IMAP override. The official Yandex endpoint is the default.
KOTMAIL_IMAP_HOST=imap.yandex.com
KOTMAIL_IMAP_PORT=993
